# ================================================================
# BizLedger - Environment Configuration Example
# ================================================================

# --- Cloudflare Worker API (Secret variables via wrangler secret put) ---
# Connection string for Neon serverless PostgreSQL:
DATABASE_URL=postgres://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/bizledger?sslmode=require

# Secret key for signing JWT tokens (HMAC-SHA256, at least 32 characters):
JWT_SECRET=replace_with_a_super_secure_random_32_char_secret_key!

# Resend API Key for sending invoices and daily cheque reminders:
RESEND_API_KEY=re_1234567890abcdef

# Allowed origin for CORS (The GitHub Pages URL or Custom Domain):
ALLOWED_ORIGIN=https://username.github.io

# Email sender address (verified in Resend):
EMAIL_FROM=BizLedger <notifications@yourdomain.com>


# --- Frontend Web Application (apps/web/.env.local) ---
# Public URL of the Cloudflare Worker API:
NEXT_PUBLIC_API_URL=https://bizledger-api.workers.dev

# Base path if deployed to GitHub Pages project subpath (e.g., /bizledger):
# Leave empty if deploying to custom domain or root GitHub user page:
NEXT_PUBLIC_BASE_PATH=
